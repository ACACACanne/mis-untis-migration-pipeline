# Environment
PROJECT_NAME="Untis to MIS Migration Pipeline"
API_V1_STR="/api/v1"
DEBUG=True

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=untis_mis_pipeline
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/untis_mis_pipeline

# Target MIS Endpoints & Credentials
ARBOR_API_BASE_URL=https://api.arbor.sc/v1
ARBOR_APP_ID=mock_arbor_app_id
ARBOR_API_KEY=mock_arbor_secret_key

BROMCOM_API_BASE_URL=https://cloudservice.bromcom.com/v1
BROMCOM_SCHOOL_ID=10001
BROMCOM_API_TOKEN=mock_bromcom_bearer_token

# Untis File Processing
UNTIS_UPLOAD_DIR=./uploads/untis
MAX_UPLOAD_SIZE_MB=25